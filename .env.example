# Copy to .env (repo root) and fill in. Never commit .env.
# Loaded automatically by Django settings; real environment variables take precedence.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave commented to use SQLite (dev only; no row locks).
# docker compose:          postgres://centrepay:centrepay@localhost:5432/centrepay
# scripts/local_postgres:  the URL it prints, with /postgres replaced by /centrepay_dev
# DATABASE_URL=

# Redis for Celery. Leave commented to run tasks inline (dev only).
# REDIS_URL=redis://localhost:6379/0

# Razorpay TEST mode. Dashboard (Test Mode toggle on) -> Account & Settings -> API Keys.
# Leave empty to use the sandbox gateway. Test keys start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> the secret you typed when adding the webhook.
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_EXPIRY_MINUTES=20
# "fake" = built-in sandbox gateway. Dev picks it automatically when RAZORPAY_KEY_ID is empty.
# PAYMENT_GATEWAY=fake
# Where a phone can reach this server (used in sandbox payment links), e.g. your LAN IP.
# PUBLIC_BASE_URL=http://192.168.1.5:8000

# Production only
# SEED_ADMIN_PASSWORD=        # creates the Django Admin superuser when seeding
# CELERY_TASK_ALWAYS_EAGER=   # true = no worker; tasks run inside web requests

SENTRY_DSN=
LOG_LEVEL=INFO
