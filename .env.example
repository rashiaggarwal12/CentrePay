# Copy to .env (repo root) and fill in. Never commit .env.
# Loaded automatically by Django settings; real environment variables take precedence.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave commented to use SQLite (dev only; no row locks).
# docker compose:          postgres://centrepay:centrepay@localhost:5432/centrepay
# scripts/local_postgres:  the URL it prints, with /postgres replaced by /centrepay_dev
# DATABASE_URL=

# Redis for Celery. Leave commented to run tasks inline (dev only).
# REDIS_URL=redis://localhost:6379/0

# Razorpay TEST mode. Dashboard (Test Mode toggle on) -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> the secret you typed when adding the webhook.
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_EXPIRY_MINUTES=20

SENTRY_DSN=
LOG_LEVEL=INFO
