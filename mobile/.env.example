# Copy to mobile/.env.local (git-ignored). Expo loads EXPO_PUBLIC_* at bundle time.
# Values are visible in the app bundle: never put secrets here.

# Leave unset in development: the app uses the Expo dev server's host on port 8000.
# EXPO_PUBLIC_API_URL=https://centrepay-api.onrender.com

# Crash reporting (optional). The React Native project's DSN from sentry.io.
# EXPO_PUBLIC_SENTRY_DSN=
